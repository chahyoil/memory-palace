{
  "name": "memory-palace",
  "version": "0.3.0",
  "private": true,
  "description": "기억력 대회 기법을 연습하는 개인용 훈련 앱 (PWA)",
  "type": "module",
  "scripts": {
    "dev": "npx --yes serve -l 5173 .",
    "dev:lan": "npx --yes serve -l tcp://0.0.0.0:5173 .",
    "check": "node scripts/check.mjs",
    "build:www": "node scripts/build-www.mjs",
    "apk": "npm run check && npm run build:www && npx cap sync android && node scripts/apk.mjs"
  },
  "devDependencies": {
    "@capacitor/android": "^8.6.2",
    "@capacitor/cli": "^8.6.2",
    "@capacitor/core": "^8.6.2"
  }
}
